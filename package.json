{
  "name": "polaris",
  "version": "0.8.0",
  "description": "Interactive coding-agent CLI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "polaris": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc && node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "lint": "biome check src test",
    "check:codex": "npm run build && node scripts/live-check.mjs codex",
    "check:claude": "npm run build && node scripts/live-check.mjs claude",
    "format": "biome check --write src test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^24.11.1",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "@anthropic-ai/sdk": "^0.125.0",
    "diff": "^8.0.4",
    "ignore": "^7.0.9",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
