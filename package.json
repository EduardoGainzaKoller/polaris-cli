{
  "name": "polaris",
  "version": "0.1.0",
  "description": "Interactive coding-agent CLI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "polaris": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^24.11.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
