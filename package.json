{
  "name": "@eduardogainzakoller/polaris",
  "version": "0.9.0",
  "description": "AI coding agent for the terminal — works with Codex, Claude and the Anthropic API (Developer Preview)",
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "claude",
    "codex",
    "anthropic",
    "terminal",
    "developer-tools"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Eduardo Gainza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoGainzaKoller/polaris-cli.git"
  },
  "homepage": "https://github.com/EduardoGainzaKoller/polaris-cli#readme",
  "bugs": {
    "url": "https://github.com/EduardoGainzaKoller/polaris-cli/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "polaris": "./dist/bin.js"
  },
  "files": [
    "dist",
    "docs/guide.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "npm run build && node dist/bin.js",
    "build": "node scripts/clean.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./test/setup.ts \"test/**/*.test.ts\"",
    "test:package": "node scripts/test-package.mjs",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "check:codex": "npm run build && node scripts/live-check.mjs codex",
    "check:claude": "npm run build && node scripts/live-check.mjs claude",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^24.11.1",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "@anthropic-ai/sdk": "^0.125.0",
    "diff": "^8.0.4",
    "ignore": "^7.0.9",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
